NSCOUT_AI_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Add any future provider vars here following the same pattern

# GitHub (unauthenticated: 60 req/hr, authenticated: 5000 req/hr)
GITHUB_TOKEN=

# Server
PORT=3000
HOST=localhost
